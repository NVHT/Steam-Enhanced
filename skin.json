{
  "name": "Steam Enhanced",
  "description": "The Steam you always wanted.",
  "author": "NVHT",
  "version": "1.0.26",
  "header_image": "https://raw.githubusercontent.com/NVHT/Steam-Enhanced/main/assets/header.png",
  "splash_image": "https://raw.githubusercontent.com/NVHT/Steam-Enhanced/main/assets/splash.png",
  "github": {
    "owner": "NVHT",
    "repo_name": "Steam-Enhanced"
  },
  "Patches": [
    {
      "MatchRegexString": ".*",
      "TargetJs": "core/core.js"
    },
    {
      "MatchRegexString": ".*",
      "TargetJs": "client/loader.js"
    }
  ],
  "Conditions": {
    "Window entrance": {
      "tab": "Startup",
      "description": "How a window appears once it has loaded. Splash plays the Steam Enhanced splash in the main window; other windows use Logo.",
      "default": "Splash",
      "values": {
        "Splash": {},
        "Logo": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/entrance-logo.css"
          }
        },
        "Fade": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/entrance-fade.css"
          }
        },
        "None": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/entrance-none.css"
          }
        }
      }
    },
    "Startup background": {
      "tab": "Startup",
      "description": "What shows behind the sign-in and startup screens.",
      "default": "Library",
      "values": {
        "Library": {},
        "Hero": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup-background-hero.css"
          }
        },
        "Mosaic": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup-background-mosaic.css"
          }
        },
        "Wall": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup-background-wall.css"
          }
        },
        "Plain": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup-background-plain.css"
          }
        },
        "Dots": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup-background-dots.css"
          }
        },
        "Steam": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup-background-steam.css"
          }
        }
      }
    },
    "Loading spinner": {
      "tab": "Startup",
      "description": "The loading spinner's style.",
      "default": "Sweep",
      "values": {
        "Sweep": {},
        "Deck": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/spinner-deck.css"
          }
        },
        "Flip": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/spinner-flip.css"
          }
        },
        "Stack": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/spinner-stack.css"
          }
        },
        "Ring": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/spinner-ring.css"
          }
        },
        "Steam": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/spinner-steam.css"
          }
        }
      }
    },
    "Library Home stage": {
      "tab": "Library",
      "description": "The Library Home stage: featured games, news and picks.",
      "default": "yes",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/home-stage-off.css"
          }
        }
      }
    },
    "In-game overlay restyle": {
      "tab": "Overlay",
      "description": "Restyle the in-game Steam Overlay.",
      "default": "yes",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/overlay-off.css"
          }
        }
      }
    },
    "Notification toasts": {
      "tab": "Toasts",
      "description": "Restyle Steam's notification toasts.",
      "default": "yes",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/toasts-off.css"
          }
        }
      }
    },
    "Toasts in game": {
      "tab": "Toasts",
      "description": "Show the restyled toasts while a game is running.",
      "default": "yes",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/toasts-ingame-off.css"
          }
        }
      }
    },
    "Toast style": {
      "tab": "Toasts",
      "description": "Stage: one card at the bottom centre. Compact: Steam's toasts, restyled.",
      "default": "Stage",
      "values": {
        "Stage": {},
        "Compact": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/toasts-style-compact.css"
          }
        }
      }
    },
    "Compact toast position": {
      "tab": "Toasts",
      "description": "Where compact toasts sit: the centre of the screen edge, or Steam's corner.",
      "default": "Centre",
      "values": {
        "Centre": {},
        "Corner": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/toasts-position-corner.css"
          }
        }
      }
    }
  },
  "Steam-WebKit": "core/font.css",
  "RootColors": "core/colors.css"
}
