{
  "name": "Steam Enhanced",
  "description": "The Steam you always wanted.",
  "author": "NVHT",
  "version": "1.3.5",
  "header_image": "https://raw.githubusercontent.com/NVHT/Steam-Enhanced/main/assets/header.png",
  "splash_image": "https://raw.githubusercontent.com/NVHT/Steam-Enhanced/main/assets/splash.png",
  "github": {
    "owner": "NVHT",
    "repo_name": "Steam-Enhanced"
  },
  "Patches": [
    {
      "MatchRegexString": ".*",
      "TargetJs": "core/core.js"
    },
    {
      "MatchRegexString": ".*",
      "TargetJs": "client/loader.js"
    }
  ],
  "Conditions": {
    "Font": {
      "tab": "Appearance",
      "description": "The theme's typeface, everywhere: client windows, Store, Community, Support and Checkout.",
      "default": "SN Pro",
      "values": {
        "SN Pro": {},
        "Xmind": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/appearance/font-xmind.css"
          }
        },
        "Steam (Motiva Sans)": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/appearance/font-motiva-sans.css"
          }
        }
      }
    },
    "Animations": {
      "tab": "Appearance",
      "description": "Reduced: hovers, presses and panels change at once instead of moving. Spinners and the window entrance still play.",
      "default": "Full",
      "values": {
        "Full": {},
        "Reduced": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/appearance/motion-reduced.css"
          }
        }
      }
    },
    "Glass effects": {
      "tab": "Appearance",
      "description": "The frosted blur behind panels, chips and bars. Off is lighter on slower PCs.",
      "default": "On",
      "values": {
        "On": {},
        "Off": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/appearance/glass-off.css"
          }
        }
      }
    },
    "Corners": {
      "tab": "Appearance",
      "description": "How rounded corners are, everywhere.",
      "default": "Default",
      "values": {
        "Default": {},
        "Sharp": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/appearance/corners-sharp.css"
          }
        },
        "Round": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/appearance/corners-round.css"
          }
        }
      }
    },
    "Window entrance": {
      "tab": "Startup",
      "description": "How a window appears once it has loaded. Splash plays the Steam Enhanced splash in the main window; other windows use Logo.",
      "default": "Splash",
      "values": {
        "Splash": {},
        "Logo": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/entrance-logo.css"
          }
        },
        "Fade": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/entrance-fade.css"
          }
        },
        "None": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/entrance-none.css"
          }
        }
      }
    },
    "Startup background": {
      "tab": "Startup",
      "description": "What shows behind the sign-in and startup screens.",
      "default": "Library",
      "values": {
        "Library": {},
        "Hero": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/background-hero.css"
          }
        },
        "Mosaic": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/background-mosaic.css"
          }
        },
        "Wall": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/background-wall.css"
          }
        },
        "Plain": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/background-plain.css"
          }
        },
        "Dots": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/background-dots.css"
          }
        },
        "Steam": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/background-steam.css"
          }
        }
      }
    },
    "Loading spinner": {
      "tab": "Startup",
      "description": "The loading spinner's style, everywhere: client windows, the Splash entrance, Store, Community, Support and Checkout.",
      "default": "Refined",
      "values": {
        "Refined": {},
        "Comet": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/spinner-comet.css"
          }
        },
        "Elastic": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/spinner-elastic.css"
          }
        },
        "Breathe": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/spinner-breathe.css"
          }
        },
        "Classic": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/startup/spinner-classic.css"
          }
        }
      }
    },
    "Game list width": {
      "tab": "Library",
      "description": "Fixed: the list scales with the window and has no divider. Adjustable: drag its right edge (double-click resets).",
      "default": "Fixed",
      "values": {
        "Fixed": {},
        "Adjustable": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/library/game-list-adjustable.css"
          }
        }
      }
    },
    "In-game overlay restyle": {
      "tab": "Overlay",
      "description": "Restyle the in-game Steam Overlay.",
      "default": "yes",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/overlay/restyle-off.css"
          }
        }
      }
    },
    "Overlay darkness": {
      "tab": "Overlay",
      "description": "How dark the backdrop behind the overlay is. Dark hides the game. The overlay's own Darkness slider overrides it.",
      "default": "Default",
      "values": {
        "Default": {},
        "Light": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/overlay/darkness-light.css"
          }
        },
        "Dark": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/overlay/darkness-dark.css"
          }
        }
      }
    },
    "Friends dock width": {
      "tab": "Friends",
      "description": "Fixed: the dock scales with the window. Adjustable: drag its left edge (double-click resets).",
      "default": "Fixed",
      "values": {
        "Fixed": {},
        "Adjustable": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/friends/dock-adjustable.css"
          }
        }
      }
    },
    "Notification toasts": {
      "tab": "Toasts",
      "description": "Restyle Steam's notification toasts.",
      "default": "yes",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/toasts/off.css"
          }
        }
      }
    },
    "Toasts in game": {
      "tab": "Toasts",
      "description": "Show the restyled toasts while a game is running.",
      "default": "yes",
      "values": {
        "yes": {},
        "no": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/toasts/in-game-off.css"
          }
        }
      }
    },
    "Toast style": {
      "tab": "Toasts",
      "description": "Stage: one card at the bottom centre. Compact: Steam's toasts, restyled.",
      "default": "Stage",
      "values": {
        "Stage": {},
        "Compact": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/toasts/style-compact.css"
          }
        }
      }
    },
    "Compact toast position": {
      "tab": "Toasts",
      "description": "Where compact toasts sit: the centre of the screen edge, or Steam's corner.",
      "default": "Centre",
      "values": {
        "Centre": {},
        "Corner": {
          "TargetCss": {
            "affects": [
              ".*"
            ],
            "src": "options/toasts/position-corner.css"
          }
        }
      }
    },
    "Web pages": {
      "tab": "Web",
      "description": "Theme: Store, Community, Support and Checkout in the theme's design. Steam's own: those pages as Steam draws them; the client stays themed. Restart Steam after changing it.",
      "default": "Theme",
      "values": {
        "Theme": {},
        "Steam's own": {
          "TargetCss": {
            "affects": [
              "https://(store\\.steampowered\\.com|steamcommunity\\.com|help\\.steampowered\\.com|checkout\\.steampowered\\.com)/.*"
            ],
            "src": "options/web/restyle-off.css"
          }
        }
      }
    }
  },
  "Steam-WebKit": "core/font.css",
  "RootColors": "core/colors.css"
}
