{
  "name": "Steam Enhanced",
  "description": "The Steam you always wanted.",
  "author": "NVHT",
  "version": "1.0.0",
  "header_image": "https://raw.githubusercontent.com/NVHT/Steam-Enhanced/main/assets/header.png",
  "splash_image": "https://raw.githubusercontent.com/NVHT/Steam-Enhanced/main/assets/splash.png",
  "github": {
    "owner": "NVHT",
    "repo_name": "Steam-Enhanced"
  },
  "Patches": [
    {
      "MatchRegexString": ".*",
      "TargetJs": "core/core.js"
    },
    {
      "MatchRegexString": ".*",
      "TargetJs": "client/loader.js"
    },
    {
      "MatchRegexString": "^Steam$",
      "TargetJs": "client/windows/main.js"
    },
    {
      "MatchRegexString": "^(?!.*(Menu|Supernav)$|notificationtoasts_)",
      "TargetJs": "client/windows/content.js"
    },
    {
      "MatchRegexString": "^(?!Steam Games List$|.*(Menu|Supernav)$|notificationtoasts_|SP Overlay:|OverlayBrowser_|OverlayTab\\d+_|SteamBrowser_Find$|Steam Big Picture Mode$|QuickAccess_|MainMenu_)",
      "TargetJs": "client/windows/desktop.js"
    },
    {
      "MatchRegexString": "^SP Overlay:",
      "TargetJs": "client/windows/overlay.js"
    },
    {
      "MatchRegexString": "^notificationtoasts_",
      "TargetJs": "client/windows/toasts.js"
    },
    {
      "MatchRegexString": "^(?:Steam$|notificationtoasts_|SP Overlay:)|Menu$",
      "TargetJs": "client/windows/notify.js"
    },
    {
      "MatchRegexString": "^(?:Steam$|SP Overlay:)",
      "TargetJs": "client/windows/achievements.js"
    },
    {
      "MatchRegexString": "^https://(?:store\\.steampowered\\.com|steamcommunity\\.com)(?:/.*)?$",
      "TargetJs": "client/friends/browser-chat-clicks.js"
    }
  ],
  "Steam-WebKit": "compat/webkit.css"
}
